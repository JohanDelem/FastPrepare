<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Section}">
  <StackPanel>
    <TextBlock Style="{StaticResource H2}" Text="6 · Installation Office 365 — Méthode ODT"/>
    <!-- Cards générées depuis config.Office.Editions -->
    <UniformGrid Name="PnlOfficeEditions" Rows="1"/>
    <StackPanel Name="PnlLicence" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
      <TextBlock Text="Licence :" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <ToggleButton Name="PillTeams" Style="{StaticResource Pill}" Content="Avec Teams" IsChecked="True"/>
      <ToggleButton Name="PillNoTeams" Style="{StaticResource Pill}" Content="Sans Teams (EEE)"/>
    </StackPanel>
    <StackPanel Name="PnlInclude" Orientation="Horizontal" Margin="0,10,0,0" IsEnabled="False">
      <TextBlock Text="Inclure :" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
      <!-- Cases générées depuis config.Office.OptionalApps -->
      <StackPanel Name="PnlIncludeItems" Orientation="Horizontal"/>
    </StackPanel>
    <TextBlock Name="TxtOfficeInfo" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
  </StackPanel>
</Border>
