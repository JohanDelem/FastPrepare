<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Section}">
  <StackPanel>
    <TextBlock Name="TxtTitle" Style="{StaticResource H2}" Text="Mises à jour"/>
    <!-- Affichée seulement si un outil constructeur coché dans « Installations » sait mettre à jour pilotes et BIOS -->
    <CheckBox Name="ChkDrivers" Visibility="Collapsed" Content="Mettre à jour les pilotes et le BIOS"/>
    <CheckBox Name="ChkWU" IsChecked="True" Content="Lancer Windows Update"/>
  </StackPanel>
</Border>
