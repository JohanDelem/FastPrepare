<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Section}">
  <StackPanel>
    <DockPanel>
      <CheckBox Name="ChkAllApps" DockPanel.Dock="Right" Content="Tout cocher" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
      <TextBlock Style="{StaticResource H2}" Text="2 · Désinstallation des logiciels installés"/>
    </DockPanel>
    <Border BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="4">
      <StackPanel>
        <Grid Background="#F7F7F7">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="96"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Nom" Margin="32,6,8,6" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
          <TextBlock Grid.Column="1" Text="Éditeur" Margin="0,6,8,6" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
          <TextBlock Grid.Column="2" Text="Silencieux" Margin="0,6,8,6" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
        </Grid>
        <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
          <StackPanel Name="PnlApps"/>
        </ScrollViewer>
        <TextBlock Name="TxtAppsLoading" Style="{StaticResource Hint}" Margin="10,6" Text="Détection en cours…"/>
      </StackPanel>
    </Border>
    <TextBlock Style="{StaticResource Hint}" Foreground="{StaticResource WarningBrush}" Margin="0,8,0,0"
               Text="⚠ = désinstallation silencieuse indisponible : l'assistant de l'application s'ouvrira, traité en dernier"/>
  </StackPanel>
</Border>
