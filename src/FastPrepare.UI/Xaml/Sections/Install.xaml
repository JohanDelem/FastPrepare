<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Section}">
  <StackPanel>
    <TextBlock Name="TxtTitle" Style="{StaticResource H2}" Text="Installations"/>

    <!-- Catalogue : cases générées depuis software.json (onglet Réglages), limitées aux entrées
         applicables au constructeur détecté -->
    <TextBlock Style="{StaticResource Sub}" Text="Logiciels du catalogue"/>
    <TextBlock Name="TxtVendorInfo" Style="{StaticResource Hint}" Margin="0,0,0,4" Text="Détection du constructeur en cours…"/>
    <StackPanel Name="PnlSoftware"/>
    <TextBlock Name="TxtSoftwareNone" Style="{StaticResource Hint}" Visibility="Collapsed"
               Text="Aucun logiciel au catalogue pour ce poste : ajoutez-en dans l'onglet Réglages."/>

    <!-- Office : cards générées depuis config.Office.Editions -->
    <TextBlock Style="{StaticResource Sub}" Margin="0,14,0,4" Text="Microsoft Office (ODT)"/>
    <UniformGrid Name="PnlOfficeEditions" Rows="1"/>
    <StackPanel Name="PnlLicence" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
      <TextBlock Text="Licence :" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <ToggleButton Name="PillTeams" Style="{StaticResource Pill}" Content="Avec Teams" IsChecked="True"/>
      <ToggleButton Name="PillNoTeams" Style="{StaticResource Pill}" Content="Sans Teams (EEE)"/>
    </StackPanel>
    <StackPanel Name="PnlInclude" Orientation="Horizontal" Margin="0,10,0,0" IsEnabled="False">
      <TextBlock Text="Inclure :" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
      <!-- Cases générées depuis config.Office.OptionalApps -->
      <StackPanel Name="PnlIncludeItems" Orientation="Horizontal"/>
    </StackPanel>
    <TextBlock Name="TxtOfficeInfo" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
  </StackPanel>
</Border>
