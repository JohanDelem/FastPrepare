{
  "ConfigVersion": 2,

  "Execution": {
    "DefaultMode": "Simulation",
    "CacheFolder": "%ProgramData%\\FastPrepare\\cache"
  },

  "Logging": {
    "Folder": "logs"
  },

  "Connectivity": {
    "TestUrl": "http://www.msftconnecttest.com/connecttest.txt",
    "Expected": "Microsoft Connect Test",
    "IntervalSeconds": 5,
    "TimeoutSeconds": 4,
    "RetrySeconds": 5
  },

  "Winget": {
    "FamilyName": "Microsoft.DesktopAppInstaller_8wekyb3d8bbwe",
    "OfflineBundle": "packages\\Microsoft.DesktopAppInstaller.msixbundle"
  },

  "Utilities": {
    "dell": {
      "Label": "Dell",
      "Subtitle": "Command Update",
      "Tool": "Dell Command Update",
      "Logo": "dell.png",
      "ManufacturerPattern": "Dell",
      "Install": [
        { "Type": "winget", "Id": "Dell.CommandUpdate.Universal", "Source": "winget" }
      ],
      "DotNet": [
        { "DcuVersion": "5.7.0", "WingetId": "Microsoft.DotNet.DesktopRuntime.8", "MinVersion": "8.0.8", "MaxVersion": "8.0.25" },
        { "DcuVersion": "5.7.1", "WingetId": "Microsoft.DotNet.DesktopRuntime.10", "MinVersion": "10.0.8", "MaxVersion": "" }
      ],
      "Update": {
        "FilePath": "%ProgramFiles%\\Dell\\CommandUpdate\\dcu-cli.exe",
        "Arguments": "/applyUpdates -reboot=disable",
        "SuccessExitCodes": [0, 500],
        "RebootExitCodes": [1, 5]
      }
    },
    "hp": {
      "Label": "HP",
      "Subtitle": "Image Assistant",
      "Tool": "HP Image Assistant",
      "Logo": "hp.png",
      "ManufacturerPattern": "HP|Hewlett",
      "Install": [
        { "Type": "winget", "Id": "HP.ImageAssistant", "Source": "winget" }
      ],
      "Update": {
        "FilePath": "HPImageAssistant.exe",
        "Arguments": "/Operation:Analyze /Action:Install /Silent",
        "SuccessExitCodes": [0, 256, 257],
        "RebootExitCodes": [3010]
      }
    },
    "lenovo": {
      "Label": "Lenovo",
      "Subtitle": "Commercial Vantage + Thin Installer",
      "Tool": "Commercial Vantage + Thin Installer",
      "Logo": "lenovo.png",
      "ManufacturerPattern": "Lenovo",
      "Install": [
        { "Type": "winget", "Id": "9NR5B8GVVM13", "Source": "msstore" },
        { "Type": "download", "Url": "", "FileName": "ThinInstallerSetup.exe", "Arguments": "/VERYSILENT /SUPPRESSMSGBOXES /NORESTART", "Sha256": "", "ExpectedSigner": "Lenovo" }
      ],
      "Update": {
        "FilePath": "%ProgramFiles(x86)%\\Lenovo\\ThinInstaller\\ThinInstaller.exe",
        "Arguments": "/CM -search A -action INSTALL -noicon -includerebootpackages 1,3,4 -noreboot",
        "SuccessExitCodes": [0],
        "RebootExitCodes": [3010]
      }
    },
    "fujitsu": {
      "Label": "Fujitsu",
      "Subtitle": "DeskUpdate",
      "Tool": "DeskUpdate",
      "Logo": "fujitsu.png",
      "ManufacturerPattern": "Fujitsu",
      "Install": [
        { "Type": "winget", "Id": "FujitsuClientComputingLimited.DeskUpdate", "Source": "winget" }
      ],
      "Update": {
        "FilePath": "ducmd.exe",
        "Arguments": "/WEB /DRV /BIOS",
        "SuccessExitCodes": [0]
      }
    }
  },

  "Office": {
    "OdtSetupUrl": "https://officecdn.microsoft.com/pr/wsus/setup.exe",
    "OdtFolder": "C:\\ODT",
    "Architecture": "64",
    "Language": "MatchOS",
    "Editions": [
      { "Key": "O365", "Label": "365 Apps for Business", "Name": "Microsoft 365 Apps for Business", "ProductId": "O365BusinessRetail", "NoTeamsProductId": "O365BusinessEEANoTeamsRetail", "Channel": "MonthlyEnterprise" },
      { "Key": "LTSC2024", "Label": "LTSC Pro Plus 2024", "Name": "Office LTSC Professional Plus 2024", "ProductId": "ProPlus2024Volume", "Channel": "PerpetualVL2024" },
      { "Key": "STD2019", "Label": "Standard 2019", "Name": "Office Standard 2019", "ProductId": "Standard2019Volume", "Channel": "PerpetualVL2019" },
      { "Key": "PP2019", "Label": "Pro Plus 2019", "Name": "Office Professional Plus 2019", "ProductId": "ProPlus2019Volume", "Channel": "PerpetualVL2019" }
    ],
    "OptionalApps": [
      { "Id": "OutlookForWindows", "Label": "Nouvel Outlook" },
      { "Id": "Outlook", "Label": "Outlook classique" },
      { "Id": "OneDrive", "Label": "OneDrive" }
    ]
  },

  "Software": [
    { "Id": "adobe-reader", "Label": "Adobe Acrobat Reader (64 bits)", "WingetId": "Adobe.Acrobat.Reader.64-bit", "Source": "winget", "Override": "-sfx_nu /sAll /rs /msi", "DefaultChecked": true }
  ],

  "Power": {
    "MonitorTimeoutMinutes": 5,
    "StandbyTimeoutMinutes": 15,
    "ApplyOnBattery": true
  },

  "ManualReminders": [
    "Réinitialisation de Windows (avant)",
    "Installation du RMM",
    "Installation de l'antivirus",
    "Chiffrement BitLocker",
    "Activation d'Office",
    "Redémarrage final"
  ]
}
