# Conventions d'édition (docs/CONTRIBUTING.md)
root = true

[*]
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Sans BOM, Windows PowerShell 5.1 lit le fichier en ANSI et casse les accents.
[*.{ps1,psm1,psd1}]
charset = utf-8-bom

[*.{xaml,json,md,cmd,txt}]
charset = utf-8

[*.{xaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
