{
  "CatalogVersion": 2,
  "Software": [
    {
      "Id": "dell-command-update",
      "Label": "Dell Command Update",
      "DefaultChecked": true,
      "ManufacturerPattern": "Dell",
      "Install": {
        "Type": "winget",
        "Id": "Dell.CommandUpdate.Universal",
        "Source": "winget",
        "Override": "",
        "Scope": ""
      },
      "DotNet": [
        {
          "ToolVersion": "5.7.0",
          "WingetId": "Microsoft.DotNet.DesktopRuntime.8",
          "MinVersion": "8.0.8",
          "MaxVersion": "8.0.25"
        },
        {
          "ToolVersion": "5.7.1",
          "WingetId": "Microsoft.DotNet.DesktopRuntime.10",
          "MinVersion": "10.0.8",
          "MaxVersion": ""
        }
      ],
      "Update": {
        "Label": "Dell Command Update",
        "FilePath": "%ProgramFiles%\\Dell\\CommandUpdate\\dcu-cli.exe",
        "Arguments": "/applyUpdates -reboot=disable",
        "SuccessExitCodes": [
          0,
          500
        ],
        "RebootExitCodes": [
          1,
          5
        ]
      }
    },
    {
      "Id": "hp-image-assistant",
      "Label": "HP Image Assistant",
      "DefaultChecked": true,
      "ManufacturerPattern": "HP|Hewlett",
      "Install": {
        "Type": "winget",
        "Id": "HP.ImageAssistant",
        "Source": "winget",
        "Override": "",
        "Scope": ""
      },
      "Update": {
        "Label": "HP Image Assistant",
        "FilePath": "HPImageAssistant.exe",
        "Arguments": "/Operation:Analyze /Action:Install /Silent",
        "SuccessExitCodes": [
          0,
          256,
          257
        ],
        "RebootExitCodes": [
          3010
        ]
      }
    },
    {
      "Id": "lenovo-commercial-vantage",
